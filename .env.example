# Ballas Gang — Discord Bot
# Copia para .env e preenche com os valores reais. Nunca commitar secrets.

NODE_ENV=production
PORT=3000

# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# PostgreSQL / Supabase
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Roles core
MANDA_CHUVA_ROLE_ID=
KINGPIN_ROLE_ID=
OG_ROLE_ID=
REAL_GANGSTER_ROLE_ID=
PATRAO_DI_ZONA_ROLE_ID=
YOUNG_BLOOD_ROLE_ID=
O_GUNAO_ROLE_ID=
GANGSTER_FODIDO_ROLE_ID=
BAIRRISTAS_BASE_ROLE_ID=
PENDENTE_ROLE_ID=
BOT_ROLE_ID=

# Onboarding / gestão Discord
TAG_REQUEST_CHANNEL_ID=
PANEL_ENTRADA_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
MEMBER_CHANNELS_CATEGORY_ID=
MEMBER_CHANNELS_OVERFLOW_CATEGORY_IDS=
MEMBER_ARCHIVE_CATEGORY_ID=

# Compatibilidade com config antiga, se ainda estiver em uso na DB/código existente
BAIRRISTA_TOPICOS_CATEGORY_ID=
BAIRRISTA_TOPICOS_OVERFLOW_CATEGORY_IDS=
BAIRRISTA_ARQUIVO_CATEGORY_ID=

# Branding
BOT_INTERNAL_NAME=Ballas Gang
BOT_DISPLAY_NAME=Ballas Gang • Gestão
BOT_COLOR=7B2CBF
BALLAS_GANG_LOGO_URL=
BOT_LOGO_URL=
WEB_APP_URL=https://ballasgang.eu

# Runtime
ENABLE_BACKGROUND_JOBS=true
BOT_OUTBOX_INTERVAL_MS=15000
ENFORCE_ROLE_INVARIANTS=true
AUTO_ASSIGN_PENDENTE=true
LOG_LEVEL=info

# Webhook opcional da webapp para o bot
DISCORD_BOT_SECRET=

# Métricas opcionais
METRICS_TOKEN=
