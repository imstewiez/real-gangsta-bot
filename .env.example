# ══════════════════════════════════════════════════════════════════════════════
# Real Gangsta — Configuração
# Ver docs/CHANGELOG.md para a lista completa do que cada variável faz.
# ══════════════════════════════════════════════════════════════════════════════

# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ── Base de dados PostgreSQL ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Role IDs — Hierarquia Real Gangsta ───────────────────────────────────────
# (Valores default em src/config.js mapeiam para o servidor actual. Substituir
#  apenas se os IDs mudarem.)
# Comando Total
MANDA_CHUVA_ROLE_ID=
KINGPIN_ROLE_ID=
# Supervisão
OG_ROLE_ID=
REAL_GANGSTER_ROLE_ID=
# Chefe de Moradores
PATRAO_DI_ZONA_ROLE_ID=
# Moradores — tier ordering (entry → topo):
#   young_blood (tier 1, entrada) → o_gunao (tier 2, após 25k€) → gangster_fodido (tier 3, após 50k€)
# Promoções excepcionais acima de Gangster Fodido são feitas manualmente (role assign).
YOUNG_BLOOD_ROLE_ID=
O_GUNAO_ROLE_ID=
GANGSTER_FODIDO_ROLE_ID=
# Role base obrigatória para qualquer morador (invariante)
MORADORES_BASE_ROLE_ID=1490397684597653634
# Roles flavor (opcional)
TROPINHAS_DO_GUETTO_ROLE_ID=
PATRULHA_PATA_ROLE_ID=
# Bot / configurador
BOT_ROLE_ID=
CONFIGURADOR_ROLE_ID=

# ── Category IDs ─────────────────────────────────────────────────────────────
MORADOR_TOPICOS_CATEGORY_ID=
MORADOR_ARQUIVO_CATEGORY_ID=

# ── Channel IDs ──────────────────────────────────────────────────────────────
TAG_REQUEST_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
PANEL_ENTRADA_CHANNEL_ID=
WEEKLY_TOP_CHANNEL_ID=
DAILY_SUMMARY_CHANNEL_ID=
CEMETERY_CHANNEL_ID=
STRUCTURE_SYNC_LOG_CHANNEL_ID=
PANEL_MORADORES_CHANNEL_ID=
PANEL_OFICIAIS_CHANNEL_ID=
PANEL_CHEFIA_CHANNEL_ID=
PANEL_CHEFE_MORADORES_CHANNEL_ID=

# ── Promoção automática (valor € em material acumulado) ──────────────────────
# Ordem: Young Blood (entry) → 25k€ → O Gunão → 50k€ → Gangster Fodido.
# Promoções fora destes thresholds (excepcionais) continuam manuais via role.
PROMO_YOUNG_BLOOD_TO_GUNAO=25000
PROMO_GUNAO_TO_GANGSTER_FODIDO=50000
# (Fallback: PROMO_GUNAO_TO_YOUNG_BLOOD e PROMO_YOUNG_BLOOD_TO_GANGSTER_FODIDO
#  da Fase 2 ainda são lidos para não partir Railway. Remove-os eventualmente.)

# ── Comportamento ────────────────────────────────────────────────────────────
ARCHIVE_ON_PROMOTION=true
DELETE_ON_PROMOTION=false
ENABLE_BACKGROUND_JOBS=true
ENFORCE_ROLE_INVARIANTS=true
PANEL_BOOTSTRAP_ON_READY=true
AUTO_PUBLISH_WEEKLY_TOP=true
# Guard-rail: quando true, /rg-sync-structure fica travado em apply mode.
# Útil para servidores com estrutura personalizada que já não queres que o
# bot toque. Dry-run continua livre para inspecção.
STRUCTURE_SYNC_LOCKED=false

# ── Painéis sticky ───────────────────────────────────────────────────────────
# Mantém os painéis sempre visíveis no fundo do canal. A cada N mensagens
# novas, o bot republica o painel no fundo (modo repost) — assim é sempre
# o primeiro que vês ao abrir o canal.
# Valores: repost (default), update (edita sempre a mesma msg), none (desligado).
PANELS_STICKY_MODE=repost
PANELS_STICKY_THRESHOLD_MSGS=5

# ── Stock notifier ───────────────────────────────────────────────────────────
# Publica embeds dos movimentos de inventário em canais dedicados da categoria
# escolhida (default: COMANDO — staff-only). O notifier faz auto-discover por
# nome, move canais existentes para a categoria certa e cria-os se faltarem.
STOCK_NOTIFY_ENABLED=true
STOCK_AUTOCREATE=true
# Categoria onde os canais de stock vivem. Valores válidos: qualquer key de
# structureTemplate.CATEGORIES (COMANDO, INVENTARIO, OFICIAIS, GUETTO, etc.).
STOCK_CHANNELS_CATEGORY_KEY=COMANDO
# Resumo periódico do stock em resumo-stock (4h por defeito).
STOCK_SUMMARY_INTERVAL_HOURS=4

# ── Rádio ────────────────────────────────────────────────────────────────────
# Canal onde o painel da rádio fica publicado/refrescado.
RADIO_PUBLISH_CHANNEL_ID=
# Range para geração aleatória (default: 1000-9999, 4 dígitos).
RADIO_RANDOM_MIN=1000
RADIO_RANDOM_MAX=9999
# Permite explicitamente 0 como valor de rádio (default: false).
RADIO_ALLOW_ZERO=false

# ── Disponibilidade diária ───────────────────────────────────────────────────
# Canal onde a chamada é publicada (também usado pelo job auto-publish).
# OBRIGATÓRIO se quiseres a auto-publicação activa.
AVAILABILITY_CHANNEL_ID=
# Horários (máximo 8). Default cobre 12:00 → 02:00 com saltos de 2h.
AVAILABILITY_SLOTS=12:00,14:00,16:00,18:00,20:00,22:00,00:00,02:00
# Roles a mencionar ao publicar. Se vazio, faz fallback para
# MORADORES_BASE_ROLE_ID (todos os moradores são alertados).
AVAILABILITY_MENTION_ROLE_IDS=
# Auto-publish diário ligado por defeito. Hora local do servidor (Railway = UTC).
# Para meia-noite em Lisboa (UTC+0 inverno / UTC+1 verão) usa 0 ou 23.
AVAILABILITY_AUTO_PUBLISH_ENABLED=true
AVAILABILITY_AUTO_PUBLISH_HOUR=0

# ── Branding ─────────────────────────────────────────────────────────────────
BOT_DISPLAY_NAME=Real Gangsta
BOT_LOGO_URL=
BOT_COLOR=E74C3C

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
DEBUG_LOG_DIR=./logs
# Rotação do log principal: tamanho máx (bytes) antes de rodar e nº de backups
LOG_MAX_BYTES=10485760
LOG_MAX_BACKUPS=3
# Cleanup automático ao boot: apaga ficheiros por sessão mais velhos que N dias
LOG_SESSION_KEEP_DAYS=7

# ── DB / instance coordination ───────────────────────────────────────────────
# Tamanho do pool de conexões PostgreSQL (default 20)
DB_POOL_MAX=20
# ID do advisory lock singleton — só mudar se partilhares DB com outro bot
INSTANCE_LOCK_ID=985432107

# ── Google Sheets (opcional) ─────────────────────────────────────────────────
# Só usar se quiseres export para Sheets. DB continua a ser fonte de verdade.
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=
