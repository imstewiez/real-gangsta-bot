{
  "name": "ballas-gang-discord-bot",
  "version": "1.0.0",
  "description": "Ballas Gang — bot Discord minimalista para onboarding, cargos e sincronização com a webapp",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node -e \"require('dotenv').config(); require('./src/dbMigrate').runMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "audit:members": "node scripts/audit-members.js",
    "test": "node --test test/*.test.js test/unit/**/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "node --test test/*.test.js test/integration/*.test.js",
    "lint": "eslint src/ test/ scripts/",
    "format": "prettier --write src/ test/ scripts/",
    "format:check": "prettier --check src/ test/ scripts/",
    "test:coverage": "c8 node --test test/*.test.js"
  },
  "dependencies": {
    "discord.js": "14.26.3",
    "dotenv": "16.6.1",
    "googleapis": "171.4.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "eslint": "8.57.1",
    "prettier": "3.5.3",
    "sinon": "22.0.0"
  }
}
