{
  "name": "real-gangsta-bot",
  "version": "1.0.0",
  "description": "Real Gangsta — Bot de gestão de bairro/grupo RP para Discord",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node -e \"require('./src/dbMigrate').runMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "stock:bootstrap": "node scripts/bootstrapStock.js",
    "stock:bootstrap:apply": "node scripts/bootstrapStock.js --apply --confirm",
    "structure:sync": "node scripts/restructureServer.js",
    "structure:sync:apply": "node scripts/restructureServer.js --apply",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "dependencies": {
    "discord.js": "14.19.3",
    "dotenv": "16.4.5",
    "googleapis": "144.0.0",
    "pg": "8.13.3"
  },
  "devDependencies": {
    "eslint": "9.18.0"
  }
}
