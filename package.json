{
  "name": "bot-di-zona",
  "version": "1.0.0",
  "description": "Bot di Zona — Bot de gestão de bairro/grupo RP para Discord",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node -e \"require('./src/dbMigrate').runMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "stock:bootstrap": "node scripts/bootstrapStock.js",
    "stock:bootstrap:apply": "node scripts/bootstrapStock.js --apply --confirm",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "discord.js": "14.26.3",
    "dotenv": "16.6.1",
    "googleapis": "171.4.0",
    "pg": "8.20.0"
  }
}
