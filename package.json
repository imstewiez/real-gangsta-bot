{
  "name": "bot-di-zona",
  "version": "1.0.0",
  "description": "Bot di Zona — Bot de gestão de bairro/grupo RP para Discord",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node -e \"require('./src/dbMigrate').runMigrations().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/ test/ scripts/",
    "format": "prettier --write src/ test/ scripts/",
    "format:check": "prettier --check src/ test/ scripts/",
    "test:coverage": "c8 node --test test/*.test.js"
  },
  "dependencies": {
    "discord.js": "14.26.3",
    "dotenv": "16.6.1",
    "googleapis": "171.4.0",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "c8": "^10.1.3",
    "prettier": "3.5.3"
  }
}
